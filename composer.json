{
    "name": "finansfatura/finansfatura",
    "description": "PHP client for the Finansfatura e-invoice (e-Fatura / e-Arşiv) API",
    "type": "library",
    "license": "MIT",
    "keywords": ["finansfatura", "efatura", "earsiv", "e-invoice", "gib", "invoicing"],
    "homepage": "https://github.com/finansfatura/ff-php",
    "authors": [{ "name": "Finansfatura" }],
    "support": {
        "issues": "https://github.com/finansfatura/ff-php/issues",
        "source": "https://github.com/finansfatura/ff-php"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-bcmath": "*"
    },
    "autoload": {
        "psr-4": { "Finansfatura\\": "src/" },
        "files": ["src/exceptions.php"]
    },
    "autoload-dev": {
        "psr-4": { "Finansfatura\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "php tests/PayloadTest.php && php tests/ClientTest.php"
    }
}
